<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
../Eavesdropper.xsd">

	<!-- Resize Handle -->
	<Button name="Eavesdropper_ResizeHandleTemplate" parentKey="ResizeHandle" hidden="true" alpha="0.5" virtual="true">
		<Size x="16" y="16"/>
		<Anchors>
			<Anchor point="BOTTOMRIGHT"/>
		</Anchors>
		<Layers>
			<Layer level="OVERLAY">
				<VectorGraphics parentKey="Texture" setAllPoints="true" file="Interface\AddOns\Eavesdropper\Resources\ResizeButton.svg"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnMouseDown>
				self:GetParent():StartSizing("BOTTOMRIGHT");
			</OnMouseDown>
			<OnMouseUp>
				self:GetParent():StopMovingOrSizing();
				self:GetParent():OnResizeFinished();
			</OnMouseUp>
			<OnEnter>
				self:GetParent():OnEnter();
				self:SetAlpha(1);
				self.Texture:SetVertexColor(0.443, 0.835, 1.000);
			</OnEnter>
			<OnLeave>
				self:GetParent():OnLeave();
				self:SetAlpha(0.5);
				self.Texture:SetVertexColor(1, 1, 1);
			</OnLeave>
		</Scripts>
	</Button>

	<Frame name="Eavesdropper_FrameTemplate" mixin="Eavesdropper_FrameMixin" virtual="true" parent="UIParent"
			toplevel="true" movable="true" clampedToScreen="true" resizable="true" frameStrata="BACKGROUND">
		<Size x="200" y="300"/>
		<ResizeBounds>
			<minResize>
				<AbsDimension x="200" y="100"/>
			</minResize>
		</ResizeBounds>
		<Anchors>
			<Anchor point="CENTER" x="0" y="0"/>
		</Anchors>

		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnEnter"/>
			<OnLeave method="OnLeave"/>
			<OnDragStart method="OnDragStart"/>
			<OnDragStop method="OnDragStop"/>
			<OnSizeChanged method="OnSizeChanged"/>
			<OnMouseWheel method="OnMouseWheel"/>
			<OnHyperlinkClick method="OnHyperlinkClick"/>
			<OnHide method="OnHide"/>
		</Scripts>

		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0.25"/>
				</Texture>
			</Layer>
		</Layers>

		<Frames>
			<Frame parentKey="NewIndicator" hidden="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="0"/>
					<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
				</Anchors>
				<Layers>
					<Layer level="ARTWORK">
						<Texture>
							<Size y="32"/>
							<Color r="0.95" g="0.75" b="0.1" a="1"/>
							<Anchors>
								<Anchor point="BOTTOMLEFT" relativeKey="$parent" relativePoint="BOTTOMLEFT"/>
								<Anchor point="BOTTOMRIGHT" relativeKey="$parent" relativePoint="BOTTOMRIGHT"/>
							</Anchors>
							<Gradient orientation="VERTICAL">
								<MinColor a="0.5" r="0.95" g="0.75" b="0.1"/>
								<MaxColor a="0.0" r="0.95" g="0.75" b="0.1"/>
							</Gradient>
						</Texture>
					</Layer>
				</Layers>

				<Animations>
					<AnimationGroup parentKey="NewIndicatorFadeIn" setToFinalAlpha="true">
						<Alpha fromAlpha="0" toAlpha="1" duration="0.3" order="1"/>
					</AnimationGroup>
					<AnimationGroup parentKey="NewIndicatorFadeOut" setToFinalAlpha="true">
						<Alpha fromAlpha="1" toAlpha="0" duration="0.3" order="1"/>
						<Scripts>
							<OnFinished>
								self:GetParent():Hide();
							</OnFinished>
						</Scripts>
					</AnimationGroup>
				</Animations>
			</Frame>

			<!-- Title Bar -->
			<Frame parentKey="TitleBar" registerForDrag="LeftButton" hidden="true">
				<Anchors>
					<Anchor point="TOPLEFT" x="0" y="0"/>
					<Anchor point="BOTTOMRIGHT" relativePoint="TOPRIGHT"><Offset x="0" y="-15"/></Anchor>
				</Anchors>

				<Layers>
					<Layer level="BACKGROUND">
						<Texture parentKey="Background" setAllPoints="true">
							<Color r="0" g="0" b="0" a="0.25"/>
						</Texture>
					</Layer>
				</Layers>

				<Scripts>
					<OnMouseDown>
						self:GetParent():OnDragStart();
					</OnMouseDown>
					<OnMouseUp>
						self:GetParent():OnDragStop();
					</OnMouseUp>
					<OnEnter>
						self:GetParent():OnEnter();
					</OnEnter>
					<OnLeave>
						self:GetParent():OnLeave();
					</OnLeave>
				</Scripts>

				<Frames>
					<!-- Close Button -->
					<Button parentKey="CloseButton">
						<Size x="12" y="12"/>
						<Anchors>
							<Anchor point="TOPRIGHT" x="-2" y="-2"/>
						</Anchors>
						<Scripts>
							<OnEnter>
								self:GetParent():GetParent():OnEnter();
							</OnEnter>
							<OnLeave>
								self:GetParent():GetParent():OnLeave();
							</OnLeave>
						</Scripts>
					</Button>

					<!-- Title Button -->
					<Button parentKey="TitleButton" registerForDrag="LeftButton">
						<Size x="110" y="15"/>
						<Anchors>
							<Anchor point="TOPLEFT"/>
						</Anchors>

						<Scripts>
							<OnLoad>
								self:RegisterForClicks("LeftButtonUp", "RightButtonUp")
							</OnLoad>
							<OnEnter>
								self:GetParent():GetParent():OnEnter();
							</OnEnter>
							<OnLeave>
								self:GetParent():GetParent():OnLeave();
							</OnLeave>
							<OnDragStart>
								self:GetParent():GetParent():OnDragStart();
							</OnDragStart>
							<OnDragStop>
								self:GetParent():GetParent():OnDragStop();
							</OnDragStop>
						</Scripts>

						<Layers>
							<!-- Hover highlight -->
							<Layer level="HIGHLIGHT">
								<Texture parentKey="Highlight" setAllPoints="true" alphaMode="ADD">
									<Color r="1" g="1" b="1" a="0.15"/>
								</Texture>
							</Layer>

							<!-- Text -->
							<Layer level="ARTWORK">
								<FontString parentKey="Text" inherits="GameFontHighlight" justifyH="CENTER" justifyV="MIDDLE" setAllPoints="true" />
							</Layer>
						</Layers>
					</Button>
				</Frames>
			</Frame>

			<!-- Resize Handle -->
			<Button parentKey="ResizeHandle" inherits="Eavesdropper_ResizeHandleTemplate"/>

			<!-- Chat Box -->
			<ScrollingMessageFrame parentKey="ChatBox">
				<Anchors>
					<Anchor point="LEFT" x="2" y="-6"/>
					<Anchor point="RIGHT" x="-2" y="-6"/>
					<Anchor point="TOP" x="0" y="-3"/>
					<Anchor point="BOTTOM" x="0" y="3"/>
				</Anchors>

				<Frames>
					<!-- Scroll Marker -->
					<Frame parentKey="ScrollMarker" hidden="true">
						<Size>
							<AbsDimension x="0" y="16"/>
						</Size>
						<Anchors>
							<Anchor point="BOTTOMLEFT" relativeTo="$parent" x="2" y="2"/>
							<Anchor point="BOTTOMRIGHT" relativeTo="$parent" x="-2" y="2"/>
						</Anchors>
						<Layers>
							<Layer level="BACKGROUND">
								<Texture parentKey="Highlight" setAllPoints="true">
									<Color r="0" g="0" b="0" a="0.25"/>
								</Texture>
							</Layer>
							<Layer level="OVERLAY">
								<FontString parentKey="Text" inherits="GameFontNormalSmall" setAllPoints="true" justifyH="CENTER" justifyV="MIDDLE">
									<Color r="1" g="1" b="1" a="1"/>
								</FontString>
							</Layer>
							<Layer level="HIGHLIGHT">
								<Texture parentKey="Background" setAllPoints="true">
									<Color r="1" g="1" b="1" a="0.15"/>
								</Texture>
							</Layer>
						</Layers>
						<Scripts>
							<OnMouseUp>
								self:GetParent():GetParent():OnScrollMarkerMouseUp();
							</OnMouseUp>
						</Scripts>
					</Frame>

					<!-- Scroll Bar -->
					<Frame parentKey="Scrollbar" inherits="Eavesdropper_SimpleSliderTemplate" hidden="true"/>
				</Frames>

				<Scripts>
					<OnHyperlinkClick>
						self:GetParent():OnHyperlinkClick(link, text, button);
					</OnHyperlinkClick>
					<OnHyperlinkEnter>
						self:GetParent():OnHyperlinkEnter(link, text, region, left, bottom, width, height);
					</OnHyperlinkEnter>
					<OnHyperlinkLeave>
						self:GetParent():OnHyperlinkLeave();
					</OnHyperlinkLeave>
				</Scripts>
			</ScrollingMessageFrame>
		</Frames>
	</Frame>

</Ui>
